msgstr "استفاده به عنوان رکورد اصلی"

msgid "Next"
msgstr "بعدی"

msgid "Merge Summary"
msgstr "خلاصه ادغام"

msgid "You're about to merge these records. You can't undo merging."
msgstr "شما در حال ادغام این رکوردها هستید. نمی‌توانید ادغام را لغو کنید."

msgid "Selected Values"
msgstr "مقادیر انتخاب شده"

msgid "Selected Value"
msgstr "مقدار انتخاب شده"

msgid "Merge"
msgstr "ادغام"

msgid "Select"
msgstr "انتخاب"

msgid "of"
msgstr "از"

msgid "Unselect"
