msgid "Clear Session"
msgstr "پاک کردن نشست"

msgid "Select Visible Items"
msgstr "انتخاب موارد قابل مشاهده"

msgid "No potential duplicates found."
msgstr "هیچ تکراری احتمالی یافت نشد."

msgid "You can only merge up to"
msgstr "شما فقط می‌توانید تا"

msgid "items at a time"
msgstr "مورد را در یک زمان ادغام کنید"

msgid "Set how duplicate records are handled once matched."
msgstr "تعیین کنید که پس از تشخیص، رکوردهای تکراری چگونه مدیریت شوند."

msgid "Conditions"
msgstr "شروط"

msgid "Details"
msgstr "جزئیات"

msgid "Define which fields are compared to detect matching records."
msgstr "تعیین کنید که کدام فیلدها برای تشخیص رکوردهای منطبق مقایسه شوند."

msgid "You do not have permission to view this."
msgstr "شما مجوز مشاهده این را ندارید."

msgid "Invalid request for potential duplicates."
msgstr "درخواست نامعتبر برای تکراری‌های احتمالی."

msgid "Missing required parameters."
msgstr "پارامترهای الزامی缺失 هستند."

msgid "Model not found."
msgstr "مدل یافت نشد."

msgid "No duplicates selected."
msgstr "هیچ تکراری انتخاب نشده است."

