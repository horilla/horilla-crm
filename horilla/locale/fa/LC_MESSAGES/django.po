msgid "You can define at most %(limit)s shift hours per company."
msgstr "شما می‌توانید حداکثر %(limit)s ساعت شیفت در هر شرکت تعریف کنید."

msgid "Select at least one weekday for the shift."
msgstr "حداقل یک روز هفته برای شیفت انتخاب کنید."

msgid "Start and end time are required when using the same hours every day."
msgstr ""
"زمان شروع و پایان در هنگام استفاده از ساعات یکسان در هر روز الزامی است."

msgid "Set start and end times for at least one weekday for the shift."
msgstr "زمان شروع و پایان را برای حداقل یک روز هفته برای شیفت تنظیم کنید."

msgid "Start and end are required for each selected shift day."
msgstr "شروع و پایان برای هر روز شیفت انتخاب شده الزامی است."

msgid "Enter start and end for at least one break day."
msgstr "شروع و پایان را برای حداقل یک روز استراحت وارد کنید."

msgid "Select at least one weekday for this break."
msgstr "حداقل یک روز هفته برای این استراحت انتخاب کنید."

msgid "Break days must be among the shift working days."
msgstr "روزهای استراحت باید جزو روزهای کاری شیفت باشند."

msgid "Break start and end are required for this mode."
msgstr "شروع و پایان استراحت برای این حالت الزامی است."

msgid ""
"Break end must be after break start. Use 24-hour time (5:30 PM is 17:30, not "
"05:30)."
msgstr ""
"پایان استراحت باید بعد از شروع استراحت باشد. از زمان ۲۴ ساعته استفاده کنید "
"(۵:۳۰ بعدازظهر برابر با ۱۷:۳۰ است، نه ۰۵:۳۰)."

#, python-format
msgid "Break on %(day)s must fall within the shift hours for that day."
msgstr "استراحت در %(day)s باید در ساعات شیفت آن روز باشد."

msgid "Invalid break time format."
msgstr "قالب زمان استراحت نامعتبر است."

msgid "A user with this email already exists."
msgstr "کاربری با این ایمیل از قبل وجود دارد."

msgid "Password"
msgstr "رمز عبور"

msgid "Enter a secure password"
msgstr "یک رمز عبور امن وارد کنید"

msgid "Confirm Password"
