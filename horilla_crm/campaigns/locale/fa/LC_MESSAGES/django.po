#: horilla_crm/campaigns/tour.py:30
msgid "Find your marketing campaigns, switch layouts, select rows and add a new campaign."
msgstr "کمپین‌های بازاریابی‌تان را پیدا کنید، چیدمان را تغییر دهید، ردیف‌ها را انتخاب کنید و کمپین جدید اضافه کنید."

#: horilla_crm/campaigns/tour.py:43
msgid "campaigns"
msgstr "کمپین‌ها"

#: horilla_crm/campaigns/tour.py:44
msgid "A campaign is a marketing effort, like an email, webinar or ad."
msgstr "کمپین یک فعالیت بازاریابی است، مثل ایمیل، وبینار یا تبلیغ."

#: horilla_crm/campaigns/tour.py:45
msgid "Add a new campaign here. A short form opens."
msgstr "از اینجا کمپین جدید اضافه کنید. یک فرم کوتاه باز می‌شود."

#: horilla_crm/campaigns/tour.py:53
msgid "Inside a Campaign"
msgstr "داخل یک کمپین"

#: horilla_crm/campaigns/tour.py:55
msgid "The summary, status and tabs of a campaign: activity, members, related opportunities, notes and history."
msgstr "خلاصه، وضعیت و زبانه‌های یک کمپین: فعالیت، اعضا، فرصت‌های مرتبط، یادداشت‌ها و تاریخچه."

#: horilla_crm/campaigns/tour.py:68
msgid "One campaign in full: its dates, status and linked records."
msgstr "یک کمپین به‌طور کامل: تاریخ‌ها، وضعیت و رکوردهای مرتبط."

#: horilla_crm/campaigns/tour.py:70
msgid "The campaign's status: New, Planned, In Progress, Completed or Aborted. Click one to update it."
